# Copy this file to .env.local and paste the team API key (ask Karol — it is
# shared privately, never committed; this repo is public).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model. Defaults to claude-opus-5; claude-sonnet-5 is
# faster and cheaper and fine for development runs.
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Database (Onramp accounts / sync) ---
# Local Postgres connection string. Local-first stays the default; the DB only
# backs opt-in account sync.
# DATABASE_URL=postgresql://localhost:5432/onramp
#
# Setup:
#   brew install postgresql@17
#   createdb onramp
